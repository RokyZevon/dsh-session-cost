{
  "name": "@rokyzevon/dsh-session-cost",
  "version": "0.1.0",
  "type": "module",
  "description": "Show this session's spend as a composer stat pill, priced per step by the model actually used",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RokyZevon/dsh-session-cost.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "fold.js",
    "pricing.js",
    "catalog.js",
    "seed-prices.json",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "engines": {
    "dsh": "^0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
